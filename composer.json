{
    "name": "ajaybhimani74/laravel-csv-import",
    "description": "Validate and import CSV files row by row in Laravel, with a per-row error report",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "csv", "import"],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "AjayBhimani\\CsvImport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AjayBhimani\\CsvImport\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AjayBhimani\\CsvImport\\CsvImportServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
